---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="section">
    <div class="container-x text-center">
      <p class="text-7xl font-bold text-brand">404</p>
      <h1 class="mt-4 text-3xl">Page not found</h1>
      <p class="mt-3 text-muted">The page you are looking for does not exist or has moved.</p>
      <a href="/" class="btn btn-navy mt-8">Back to home</a>
    </div>
  </section>
</BaseLayout>
