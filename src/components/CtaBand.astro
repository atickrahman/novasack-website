---
import { site } from '../data/site';
---

<section class="bg-brand">
  <div class="container-x flex flex-col items-start justify-between gap-6 py-12 md:flex-row md:items-center">
    <div>
      <h2 class="text-2xl text-white md:text-3xl">Let's build your packaging solution together.</h2>
      <p class="mt-2 text-white/85">Tell us your size, load and print requirements, and we will send a quotation.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href="/contact#quote" class="btn bg-white text-brand hover:bg-navy-900 hover:text-white">Request a Quote</a>
      <a href={site.phoneHref} class="btn btn-outline">Call {site.phone}</a>
    </div>
  </div>
</section>
