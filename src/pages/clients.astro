---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { clients } from '../data/site';
---

<BaseLayout
  title="Our Clients"
  description="Nova Sack supplies PP woven bags to leading organisations in Bangladesh, including fertilizer, sugar and flour producers."
>
  <PageHero
    eyebrow="Trusted by leading organisations"
    title="Our Clients"
    subtitle="Quality you can measure. Service you can trust."
  />

  <section class="section">
    <div class="container-x">
      <!-- TODO: swap the text tiles for client logos once permission is confirmed -->
      <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
        {clients.map((c) => (
          <div class="flex min-h-28 items-center justify-center rounded-xl border border-gray-200 bg-white p-6 text-center text-lg font-semibold text-navy-900 shadow-sm">
            {c}
          </div>
        ))}
        <div class="flex min-h-28 flex-col items-center justify-center rounded-xl bg-navy-900 p-6 text-center text-white">
          <p class="text-lg font-semibold">Serving Bangladesh</p>
          <p class="text-sm text-white/70">since 2023</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
